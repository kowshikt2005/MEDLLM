# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── App ─────────────────────────────────────────
DEBUG=true

# ── Auth ────────────────────────────────────────
# Generate a random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# ── Ollama ──────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
# Must exactly match a local model listed by `ollama list`.
# Example: mistral:latest
OLLAMA_MODEL=mistral:latest

# ── Groq (optional — needed for reasoning mode) ─
# Reasoning mode sends planning and synthesis requests to Groq's cloud API.
# GROQ_API_KEY=gsk_your_key_here

# ── Whisper (speech-to-text) ────────────────────
# The application uses the local openai-whisper package.
WHISPER_MODEL=small
